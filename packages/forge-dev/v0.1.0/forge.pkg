[package]
name = "forge-dev"
version = "0.1.0"
description = "Developer toolkit for creating and managing Forge package repositories"
license = "MIT"

[source]
url = "https://github.com/ItzSevrus/forgeRepo/releases/download/forge-dev-v0.1.0/forge-dev-0.1.0.tar.gz"
checksum = "sha256:ec7b354aba4b3f7273ee4248b71f74a972c27096000264159cd20b86fb9f91d0"

[build]
script = "build.sh"
command = "./build.sh"
compilers = []

[dependencies]
runtime = []
build = []

[dependencies.system]
apt = ["git", "coreutils", "tar", "gh"]
pacman = ["git", "coreutils", "tar", "github-cli"]
dnf = ["git", "coreutils", "tar", "gh"]
zypper = ["git", "coreutils", "tar", "gh"]