[package]
name = "forge-dev"
version = "0.1.0"
description = "Developer toolkit for creating and managing Forge package repositories"
license = "MIT"

[source]
url = "https://github.com/ItzSevrus/forgeRepo/releases/download/forge-dev-v0.1.0/forge-dev-v0.1.0.tar.gz"
checksum = "sha256:9c30983e22a14e485c07a8d5b294c7e4d37916331f39cd9ad0e936b5b591dd47"

[build]
script = "build.sh"
command = "./build.sh"
compilers = []

[dependencies]
runtime = []
build = []

[dependencies.system]
apt = ["git", "coreutils", "tar", "gh"]
pacman = ["git", "coreutils", "tar"]
dnf = ["git", "coreutils", "tar", "gh"]
zypper = ["git", "coreutils", "tar", "gh"]