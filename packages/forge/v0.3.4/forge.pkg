[package]
name = "forge"
version = "0.3.3"
description = "A lightweight community package manager for Arch Linux"
license = "MIT"

[source]
url = "https://github.com/ItzSevrus/forgeRepo/releases/download/forge-v0.3.3/forge-v0.3.3.tar.gz"
checksum = "sha256:6dc83d7a152afb3b8fc8c9361861adf9c86b7b2e501f43faabbedd87f39745c5"

[build]
script = "build.sh"
command = "./build.sh"
compilers = ["cc"]
system_dependencies = ["make", "pkg-config"]

[dependencies]
runtime = []
build = []

[dependencies.system]
apt = ["build-essential", "pkg-config", "libcurl4-openssl-dev", "libssl-dev"]
pacman = ["base-devel", "pkgconf", "curl", "openssl"]
dnf = ["gcc", "make", "pkgconf-pkg-config", "libcurl-devel", "openssl-devel"]
zypper = ["gcc", "make", "pkg-config", "libcurl-devel", "libopenssl-devel"]
