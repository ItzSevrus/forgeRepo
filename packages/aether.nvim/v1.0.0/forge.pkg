[package]
name = "aether.nvim"
version = "1.0.0"
description = "A personalized Neovim IDE with terminal, file explorer, C/C++ and Python support"
license = "MIT"

[source]
url = "https://github.com/ItzSevrus/forgeRepo/releases/download/aether.nvim-v1.0.0/aether-nvim-v1.0.tar.gz"
checksum = "sha256:133ec782ba98273149cdb02af226b3282d1fa0ecef26ac3283566d61d86f9514"

[build]
script = "build.sh"
command = "./build.sh"
compilers = []

[dependencies]
runtime = []
build = []

[dependencies.system]
apt = ["neovim", "git", "ripgrep", "fd-find", "unzip", "wl-clipboard", "build-essential", "clang", "clangd", "cmake", "ninja-build", "python3", "python3-pip", "python3-venv", "nodejs", "npm"]
pacman = ["neovim", "git", "ripgrep", "fd", "unzip", "wl-clipboard", "base-devel", "clang", "cmake", "ninja", "python", "python-pip", "python-virtualenv", "nodejs", "npm"]
dnf = ["neovim", "git", "ripgrep", "fd-find", "unzip", "wl-clipboard", "gcc", "gcc-c++", "make", "clang", "clang-tools-extra", "cmake", "ninja-build", "python3", "python3-pip", "python3-virtualenv", "nodejs", "npm"]
zypper = ["neovim", "git", "ripgrep", "fd", "unzip", "wl-clipboard", "gcc", "gcc-c++", "make", "clang", "clang-tools", "cmake", "ninja", "python3", "python3-pip", "python3-virtualenv", "nodejs", "npm"]

